@prefix git-lex: <https://repolex.ai/ontology/git-lex/> .
@prefix autoknow: <https://repolex.ai/ontology/kit/autoknow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# AUTOKNOW KIT ONTOLOGY
# =============================================================================
# Automated knowledge organization from unstructured sources.
# Subagents read Sources, extract SPO triples, and build typed entity pages.
#
# Kit: autoknow
# Namespace: autoknow: = https://repolex.ai/ontology/kit/autoknow/
# Foldering: OPT-IN — Source + Entity are authored (git lex create),
# so each carries git-lex:foldered true. lex-o retired (2026-07-18). See
# subtexture/docs/ontology/2026_07_18_FOLDERING_GATE_AND_LEX_O_RETIREMENT.md.
#
# Document types (= valid `git lex create` commands):
#   source, entity
#
# The core classes are Source (input) and Entity (output). Additional classes
# (Person, Project, Tool, etc.) emerge dynamically via extraction — they are
# NOT predefined here. The Ontologist phase may later formalize emerged
# classes into agent-editable ontology files.
#
# All constraints (required fields, enums, types) are encoded here.
# SHACL shapes are generated from this file — do not hand-edit shapes.
# =============================================================================

<https://repolex.ai/ontology/kit/autoknow> a owl:Ontology ;
    rdfs:label "AutoKnow Kit Ontology" ;
    rdfs:comment "Automated knowledge organization from unstructured sources via subagent extraction. Adaptive: this file is seeded by the kit and then OWNED and EDITED by the Ontologist subagent at runtime. Lives at _ontology/autoknow/autoknow.ttl in the user repo." ;
    owl:versionInfo "0.3.2" .

# v0.3.2 (2026-09-16, ruled by goodlux): every date property is named
#   `<what>Date`, type at the end, across every kit. autoknow:dateCaptured is
#   now autoknow:capturedDate and autoknow:dateUpdated is autoknow:updatedDate.
#   Frontmatter keys follow (autoknow.Source.capturedDate, .updatedDate).
#   Lands with git-lex-kit-base 0.18.0, which renames the universals
#   git-lex:dateCreated / dateUpdated to createdDate / updatedDate. No range,
#   domain or cardinality changed. Not done here: rewriting existing Source
#   documents; the base kit's reader accepts the old keys for one release
#   and warns with the new line to write.
#
# v0.3.1 (2026-08-11, Rob-ruled): autoknow:Entity and autoknow:Source declare
#   `rdfs:subClassOf git-lex:Thing`. git-lex 0.9 introduced the Thing class so
#   the five universal authored properties (id, title, abstract, cue,
#   relatedToId) had a domain to attach to rather than being declared
#   domain-open, which the save gate cannot see. No property, range, or
#   cardinality changed. NOTE: this file is seeded by the kit and then owned and
#   edited by the Ontologist subagent at runtime — a runtime regeneration that
#   does not carry these lines forward will silently un-Thing both classes.


# =============================================================================
# ENUM DATATYPES
# =============================================================================

autoknow:SourceTypeValue a rdfs:Datatype ;
    owl:oneOf ("conversation" "document" "webpage" "chat" "email" "note") .

autoknow:ExtractionStatusValue a rdfs:Datatype ;
    owl:oneOf ("pending" "extracted" "failed" "skipped") .


# =============================================================================
# DOCUMENT TYPES
# =============================================================================

# --- Source ---
# A raw input document wrapped as markdown for the extraction pipeline.
# Sources are never edited after creation — they are frozen primary facts.

autoknow:Source a owl:Class ;
    rdfs:subClassOf git-lex:Thing ;
    git-lex:foldered true ;
    rdfs:label "Source" ;
    rdfs:comment "A raw input document (conversation, PDF, webpage, etc.) wrapped as markdown. Frozen after creation — never edited. Subagents read Sources and extract knowledge from them." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty autoknow:sourceId ;
        owl:minCardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty autoknow:sourceType ;
        owl:minCardinality 1
    ] .

autoknow:sourceId a owl:DatatypeProperty ;
    rdfs:label "source id" ;
    rdfs:comment "Canonical identifier for this Source (e.g. conversation UUID)." ;
    rdfs:domain autoknow:Source ;
    rdfs:range xsd:string .

autoknow:sourceType a owl:DatatypeProperty ;
    rdfs:label "source type" ;
    rdfs:comment "What kind of source this is." ;
    rdfs:domain autoknow:Source ;
    rdfs:range autoknow:SourceTypeValue .

autoknow:sourceName a owl:DatatypeProperty ;
    rdfs:label "source name" ;
    rdfs:comment "Human-readable name or title of the Source." ;
    rdfs:domain autoknow:Source ;
    rdfs:range xsd:string .

autoknow:capturedDate a owl:DatatypeProperty ;
    rdfs:label "captured date" ;
    rdfs:comment "When this Source was originally created or captured." ;
    rdfs:domain autoknow:Source ;
    rdfs:range xsd:dateTime .

autoknow:updatedDate a owl:DatatypeProperty ;
    rdfs:label "updated date" ;
    rdfs:comment "When this Source was last updated (if applicable)." ;
    rdfs:domain autoknow:Source ;
    rdfs:range xsd:dateTime .

autoknow:messageCount a owl:DatatypeProperty ;
    rdfs:label "message count" ;
    rdfs:comment "Number of messages in a conversation Source." ;
    rdfs:domain autoknow:Source ;
    rdfs:range xsd:integer .

autoknow:extractionStatus a owl:DatatypeProperty ;
    rdfs:label "extraction status" ;
    rdfs:comment "Whether this Source has been processed by the Extractor." ;
    rdfs:domain autoknow:Source ;
    rdfs:range autoknow:ExtractionStatusValue .


# --- Entity ---
# An auto-generated page describing a single entity discovered across Sources.
# Created and maintained by the AutoKnow pipeline. May be reviewed by a Soul.

autoknow:Entity a owl:Class ;
    rdfs:subClassOf git-lex:Thing ;
    git-lex:foldered true ;
    rdfs:label "Entity" ;
    rdfs:comment "An auto-generated page for a single entity (person, project, tool, concept, etc.) discovered by extraction from Sources. Contains a typed description, properties, and relationships." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty autoknow:entityId ;
        owl:minCardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty autoknow:entityType ;
        owl:minCardinality 1
    ] .

autoknow:entityId a owl:DatatypeProperty ;
    rdfs:label "entity id" ;
    rdfs:comment "Canonical identifier for this Entity (kebab-case name)." ;
    rdfs:domain autoknow:Entity ;
    rdfs:range xsd:string .

autoknow:entityType a owl:DatatypeProperty ;
    rdfs:label "entity type" ;
    rdfs:comment "The auto-discovered class of this Entity (e.g. Person, Project, Tool). Not a fixed enum — classes emerge from extraction and may later be formalized in an agent-edited ontology." ;
    rdfs:domain autoknow:Entity ;
    rdfs:range xsd:string .

autoknow:entityDescription a owl:DatatypeProperty ;
    rdfs:label "entity description" ;
    rdfs:comment "A 2-4 sentence factual description synthesized from observed facts across Sources." ;
    rdfs:domain autoknow:Entity ;
    rdfs:range xsd:string .

autoknow:mentionCount a owl:DatatypeProperty ;
    rdfs:label "mention count" ;
    rdfs:comment "Number of source-line mentions across all Sources." ;
    rdfs:domain autoknow:Entity ;
    rdfs:range xsd:integer .
